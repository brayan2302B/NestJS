# Puerto en el que corre la aplicación del Backend
PORT=3000

# Clave secreta para la firma de tokens JWT
JWT_SECRET=tu-clave-secreta-aqui

# URL del Frontend (para CORS) - Separadas por comas si hay múltiples
# Ejemplo: http://localhost:5173,https://tu-app-frontend.vercel.app
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Configuración de Base de Datos
# DATABASE_URL es útil para conexiones directas en hosting como Render, Railway, Heroku, etc.
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db

# Parámetros individuales de base de datos
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=usuario
DB_PASSWORD=password
DB_NAME=nombre_db
DB_SYNCHRONIZE=false
